+func pogCacheValue(c carapace.Context, selector string) (string, error) {
+	switch {
+	case selector == "cwd":
+		return c.Dir, nil
+	case selector == "value":
+		return c.Value, nil
+	case strings.HasPrefix(selector, "flag:"):
+		name := strings.ToUpper(strings.TrimPrefix(selector, "flag:"))
+		return c.Getenv("C_FLAG_" + name), nil
+	case strings.HasPrefix(selector, "argument:"):
+		index, err := strconv.Atoi(strings.TrimPrefix(selector, "argument:"))
+		if err != nil || index < 0 || index >= len(c.Args) {
+			return "", nil
+		}
+		return c.Args[index], nil
+	case strings.HasPrefix(selector, "env:"):
+		return c.Getenv(strings.TrimPrefix(selector, "env:")), nil
+	default:
+		return "", fmt.Errorf("unknown pog cache selector: %q", selector)
+	}
+}
