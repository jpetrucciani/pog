+type pogCandidate struct {
+	Value       string `json:"value"`
+	Description string `json:"description"`
+	Style       string `json:"style"`
+	Tag         string `json:"tag"`
+}
+
+func pogValues(encoded string) carapace.Action {
+	var candidates []pogCandidate
+	if err := json.Unmarshal([]byte(encoded), &candidates); err != nil {
+		return carapace.ActionMessage(err.Error())
+	}
+
+	batch := carapace.Batch()
+	for _, candidate := range candidates {
+		action := carapace.ActionStyledValuesDescribed(
+			candidate.Value,
+			candidate.Description,
+			candidate.Style,
+		)
+		if candidate.Tag != "" {
+			action = action.Tag(candidate.Tag)
+		}
+		batch = append(batch, action)
+	}
+	return batch.ToA()
+}
