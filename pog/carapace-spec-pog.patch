+type pogDynamicConfig struct {
+	Script       string   `json:"script"`
+	Legacy       string   `json:"legacy"`
+	CacheSeconds int      `json:"cacheSeconds"`
+	CacheBy      []string `json:"cacheBy"`
+}
+
+func pogDynamic(encoded string) carapace.Action {
+	var config pogDynamicConfig
+	if err := json.Unmarshal([]byte(encoded), &config); err != nil {
+		return carapace.ActionMessage(err.Error())
+	}
+
+	return carapace.ActionCallback(func(c carapace.Context) carapace.Action {
+		completionContext := addPogCompletionEnvironment(c)
+		arguments := []string{}
+		preamble := ""
+		invocation := "_pog_completion_provider"
+		if config.Legacy != "" {
+			previous := ""
+			if len(c.Args) > 0 {
+				previous = c.Args[len(c.Args)-1]
+			}
+			preamble = "current=$1; previous=$2; shift 2\n"
+			arguments = append(arguments, c.Value, previous)
+			if config.Legacy == "argument" {
+				invocation += " \"$current\""
+			}
+		}
+
+		wrapped := preamble + "_pog_completion_provider() {\n" + config.Script + "\n}\n" + invocation
+		action := shellCommand("bash", wrapped, arguments...)
+		if config.CacheSeconds <= 0 {
+			return action.Invoke(completionContext).ToA()
+		}
+
+		cacheValues := []string{encoded}
+		for _, selector := range config.CacheBy {
+			value, err := pogCacheValue(completionContext, selector)
+			if err != nil {
+				return carapace.ActionMessage(err.Error())
+			}
+			cacheValues = append(cacheValues, selector, value)
+		}
+		return action.Cache(
+			time.Duration(config.CacheSeconds)*time.Second,
+			key.String(cacheValues...),
+		).Invoke(completionContext).ToA()
+	})
+}
+
+func addPogCompletionEnvironment(c carapace.Context) carapace.Context {
+	c.Setenv("POG_COMPLETION_VALUE", c.Value)
+	c.Setenv("POG_COMPLETION_INDEX", strconv.Itoa(len(c.Args)))
+	c.Setenv("POG_COMPLETION_DIR", c.Dir)
+
+	for index, argument := range c.Args {
+		c.Setenv(fmt.Sprintf("POG_COMPLETION_ARG_%d", index), argument)
+	}
+	if encoded, err := json.Marshal(c.Args); err == nil {
+		c.Setenv("POG_COMPLETION_ARGS_JSON", string(encoded))
+	}
+
+	flags := make(map[string]string)
+	for _, variable := range c.Env {
+		name, value, found := strings.Cut(variable, "=")
+		if !found || !strings.HasPrefix(name, "C_FLAG_") {
+			continue
+		}
+		flagName := strings.TrimPrefix(name, "C_FLAG_")
+		flags[flagName] = value
+		environmentName := strings.NewReplacer("-", "_", ".", "_").Replace(flagName)
+		c.Setenv("POG_COMPLETION_FLAG_"+environmentName, value)
+	}
+	if encoded, err := json.Marshal(flags); err == nil {
+		c.Setenv("POG_COMPLETION_FLAGS_JSON", string(encoded))
+	}
+	return c
+}
